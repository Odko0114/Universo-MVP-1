# Copy this file to .env and fill in real values before running in production.
# In local dev, everything below has a safe fallback — .env is optional.

# --- Core ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Silence debug logs in prod: error | warn | info | debug (default: info)
LOG_LEVEL=info

# Where runtime data lives (accounts, clicks, events, caches). Unset locally
# (defaults to ./data). In production, point at a persistent volume OUTSIDE
# the repo tree, e.g. /var/data — see DEPLOYMENT.md.
UNIVERSO_DATA_DIR=

# --- Auth -----------------------------------------------------------------
# REQUIRED in production (NODE_ENV=production) — the server refuses to boot
# without it. In dev, a random secret is generated per boot if this is unset,
# which means every restart logs everyone out. Generate one with:
#   openssl rand -hex 32
UNIVERSO_JWT_SECRET=

# --- Admin dashboard bootstrap (optional) ----------------------------------
# If set AND no admin account exists yet, one is created automatically at
# boot with these credentials. Prefer this over `npm run create-admin` when
# deploying, so the password never has to be typed into a shell history or a
# chat. Leave unset after the first admin exists — it's a one-time bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Data import overrides (optional) --------------------------------------
# Only used by `npm run import:*` scripts, never by the running server.
# Override the source URL for the global-universities import.
GLOBAL_UNIS_URL=
# Override the source URL for the CWUR rankings import.
RANKINGS_URL=
