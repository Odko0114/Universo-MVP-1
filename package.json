{
  "name": "universo",
  "version": "0.1.0",
  "description": "Universo — a mobile-first platform that helps international students discover and compare universities abroad (MVP).",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js --force",
    "import:eter": "node scripts/import-eter.js",
    "import:global": "node scripts/import-global.js",
    "import:rankings": "node scripts/import-rankings.js",
    "import:all": "node scripts/import-eter.js && node scripts/import-global.js && node scripts/import-rankings.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc -p jsconfig.json"
  },
  "keywords": [
    "universities",
    "education",
    "students",
    "mvp"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4"
  }
}
